{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:-n*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "Bash(date:*)",
      "WebFetch(domain:www.gesetze-im-internet.de)",
      "WebFetch(domain:www.bundesfinanzministerium.de)",
      "WebFetch(domain:www.elster.de)",
      "WebFetch(domain:www.bzst.de)",
      "WebFetch(domain:www.finanzamt.niedersachsen.de)",
      "WebFetch(domain:www.lstn.niedersachsen.de)",
      "WebFetch(domain:www.bstbk.de)",
      "WebFetch(domain:www.stbk-niedersachsen.de)",
      "WebFetch(domain:www.datev.de)",
      "WebFetch(domain:www.haufe.de)",
      "WebFetch(domain:www.destatis.de)",
      "WebFetch(domain:www.bundesbank.de)",
      "WebFetch(domain:www.unternehmensregister.de)",
      "WebFetch(domain:www.transparenzregister.de)",
      "WebFetch(domain:www.deutsche-rentenversicherung.de)",
      "WebFetch(domain:www.gkv-spitzenverband.de)",
      "WebFetch(domain:www.kuenstlersozialkasse.de)",
      "WebFetch(domain:www.dguv.de)"
    ],
    "deny": [
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/.env)"
    ]
  }
}
